/* pages/recommend/recommend.wxss - 号码推荐页
   设计稿：Content padding 40rpx 左右 / 8rpx 上 / 32rpx 下，组间距 32rpx

   2026-10-16 深色模式 + 层级校正：
   - 裸色值全部改为语义令牌。
   - 号码卡由大面积暖黄底（#FFF4C4，与首页「真实待兑奖」同色）降级为普通卡片，
     只在标题行留小面积暖色点缀。理由：这是**趣味推演**，与真实中奖同重要度是层级错误；
     同时暖黄实底在深色下无法成立（方案 §2.1 / §6.6）。 */

.recommend {
  padding-top: 8rpx;
  padding-bottom: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 导航栏（设计稿：仅标题；高度由 JS 按胶囊对齐注入） */
.nav-bar {
  display: flex;
  align-items: center;
  padding-left: 40rpx;
  padding-right: 40rpx;
  box-sizing: border-box;
}

.nav-bar__title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* 顶部控制区 */
.recommend-controls {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  background: var(--surface-card);
  border-radius: 36rpx;
  box-shadow: var(--elev-1);
  padding: 28rpx;
  box-sizing: border-box;
}

.recommend-controls__section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recommend-controls__section--compact {
  padding-top: 4rpx;
}

.recommend-controls__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.recommend-controls__label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.recommend-controls__hint {
  font-size: 22rpx;
  color: var(--text-muted);
}

.recommend-switch {
  display: flex;
  gap: 8rpx;
  min-height: 88rpx;
  background: var(--surface-sunken);
  border-radius: 44rpx;
  padding: 8rpx;
  box-sizing: border-box;
}

.recommend-switch__item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 16rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-secondary);
  text-align: center;
  box-sizing: border-box;
}

.recommend-switch__item--active {
  background: var(--selection-bg);
  color: var(--selection-text);
  font-weight: 600;
}

/* 按压反馈：带 .recommend-switch 前缀压过基础/选中态优先级，
   选中项按压时保持选中底色（不做「按一下变灰」的假故障效果） */
.recommend-switch .recommend-switch__item--press {
  background: var(--surface-pressed);
}

.recommend-switch .recommend-switch__item--active.recommend-switch__item--press {
  background: var(--selection-bg);
}

.recommend-switch--lottery .recommend-switch__item {
  font-size: 26rpx;
}

/* 用户信息 */
.recommend-profile {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.recommend-profile__item {
  width: calc((100% - 16rpx) / 2);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: var(--surface-sunken);
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
}

.recommend-profile__label {
  font-size: 22rpx;
  color: var(--text-muted);
  flex-shrink: 0;
}

.recommend-profile__value {
  flex: 1;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
  text-align: right;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.recommend__notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: var(--surface-sunken);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
}

.recommend__notice-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--text-muted);
}

.recommend__notice-action {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 号码卡（2026-10-16 由暖黄实底降级为普通卡片，标题行留小面积暖色） */
.numbers-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  background: var(--surface-card);
  border-radius: 48rpx;
  box-shadow: var(--elev-1);
  padding: 40rpx 44rpx 44rpx;
  box-sizing: border-box;
}

.numbers-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 48rpx;
}

.numbers-card__head-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 唯一的暖色点缀：仅这一处，用于区分「推演结果」而非真实中奖。
   用品牌杏橙的深档（琥珀留给"待兑奖"这一种语义，不混用）。 */
.numbers-card__head-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--accent-strong);
}

.numbers-card__head-date {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-muted);
}

/* 号码区（红蓝球统一 44px 圆球） */
.ball-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.ball-section__label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-muted);
}

.ball-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ball {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ball-on-fill);
}

.ball--red {
  background: var(--ball-red-fill);
}

.ball--blue {
  background: var(--ball-blue-fill);
}

/* 推演摘要 */
.numbers-card__analysis {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: var(--surface-sunken);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.numbers-card__analysis-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.numbers-card__analysis-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.numbers-card__analysis-action {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.numbers-card__summary {
  width: 100%;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 40rpx;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 免责声明：正常可读，不弱化「仅供娱乐」的提示强度 */
.recommend__disclaimer {
  font-size: 22rpx;
  color: var(--text-muted);
  text-align: center;
}

/* 重新生成 */
.recommend__regen {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.recommend__regen-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--action-text);
}

/* ==================== 分析抽屉（短详情档 ≈ 62vh） ==================== */

.recommend-drawer__mask {
  position: fixed;
  inset: 0;
  background: var(--overlay);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}

.recommend-drawer {
  width: 100%;
  height: 62vh;
  min-height: 760rpx;
  max-height: calc(100vh - 180rpx);
  background: var(--surface-raised);
  border-radius: 40rpx 40rpx 0 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.recommend-drawer__handle {
  width: 88rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--sheet-handle);
  margin: 20rpx auto 24rpx;
}

.recommend-drawer__header {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 0 32rpx 24rpx;
}

.recommend-drawer__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.recommend-drawer__desc {
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--text-muted);
}

.recommend-drawer__body {
  flex: 1;
  height: 0;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.recommend-drawer__text {
  display: block;
  padding: 28rpx;
  background: var(--surface-sunken);
  border-radius: 28rpx;
  font-size: 26rpx;
  line-height: 48rpx;
  color: var(--text-secondary);
}

/* 逐段渲染：段间留白，阅读更舒适（2026-08-20 优化） */
.recommend-drawer__para {
  display: block;
}

.recommend-drawer__para + .recommend-drawer__para {
  margin-top: 20rpx;
}

.recommend-drawer__actions {
  display: flex;
  gap: 24rpx;
  padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  background: var(--surface-raised);
}

.recommend-drawer__action {
  flex: 1;
}
