/* pages/record/record.wxss - 录入彩票页
   设计稿：Content padding 40rpx 左右 / 8rpx 上 / 32rpx 下，组间距 28rpx
   2026-10-16：除取景器内部画面外，全部裸色值改为语义令牌。 */

.record {
  padding-top: 8rpx;
  padding-bottom: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

/* 导航栏（高度由 JS 按胶囊对齐注入，仅保留标题） */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 40rpx;
  padding-right: 40rpx;
  box-sizing: border-box;
}

.nav-bar__title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* 拍照取景卡 */
.capture-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 32rpx 36rpx 36rpx;
}

.capture-card__header {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.capture-card__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.capture-card__desc {
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--text-muted);
}

/* 取景器：以下 #111111 / 白字 / 金色引导线属于「相机画面」而非页面主题，
   不做深色适配 —— 实时画面不对主题做反色或亮度滤镜（方案 §6.2）。 */
.camera-shell {
  position: relative;
  height: 520rpx;
  border-radius: 36rpx;
  overflow: hidden;
  background: #111111;
}

.camera-preview {
  width: 100%;
  height: 100%;
}

.camera-preview--recognizing {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: linear-gradient(180deg, #2A2A2C 0%, #111111 100%);
}

/* 2026-09-04 新增：识别中遮罩层（叠加在保持挂载的相机之上，不再销毁相机组件） */
.camera-recognizing-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: rgba(17, 17, 17, 0.86);
}

.camera-preview__status {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.camera-preview__hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.camera-guide {
  position: absolute;
  width: 44rpx;
  height: 44rpx;
  border-color: var(--camera-guide);
  pointer-events: none;
}

.camera-guide--tl {
  top: 28rpx;
  left: 28rpx;
  border-top: 6rpx solid var(--camera-guide);
  border-left: 6rpx solid var(--camera-guide);
  border-top-left-radius: 16rpx;
}

.camera-guide--tr {
  top: 28rpx;
  right: 28rpx;
  border-top: 6rpx solid var(--camera-guide);
  border-right: 6rpx solid var(--camera-guide);
  border-top-right-radius: 16rpx;
}

.camera-guide--bl {
  bottom: 28rpx;
  left: 28rpx;
  border-bottom: 6rpx solid var(--camera-guide);
  border-left: 6rpx solid var(--camera-guide);
  border-bottom-left-radius: 16rpx;
}

.camera-guide--br {
  right: 28rpx;
  bottom: 28rpx;
  border-right: 6rpx solid var(--camera-guide);
  border-bottom: 6rpx solid var(--camera-guide);
  border-bottom-right-radius: 16rpx;
}

/* 识别结果卡片 */
.result-card {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding: 32rpx 36rpx;
}

.result-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.result-card__meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.result-card__text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.result-card__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.result-card__period {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* OCR 徽章（2026-10-16 拆成两态）：
   自动识别 = 暗金底；已手动校对 = 成功底。
   此前两态共用同一颜色，用户看不出「这组号码到底核对过没有」。 */
.ocr-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
}

.ocr-badge--auto {
  background: var(--attention-bg);
}

.ocr-badge--auto .ocr-badge__text {
  color: var(--attention-text);
}

.ocr-badge--verified {
  background: var(--success-bg);
}

.ocr-badge--verified .ocr-badge__text {
  color: var(--success-text);
}

.ocr-badge__text {
  font-size: 22rpx;
  font-weight: 700;
}

/* 投注号码列表 */
.bets {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.bets__hint {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-muted);
}

.bet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 60rpx;
}

.bet-row--editable {
  padding: 8rpx 0;
}

.bet-row__tail {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.bet-row__nums {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 红蓝区隔符（2026-08-20 新增：红球与蓝球之间加 "-" 区分） */
.bet-row__dash {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-muted);
  margin: 0 4rpx;
}

/* 圆球：实心填充色与「文字/图标色」是两个令牌（球内数字用 ball-on-fill） */
.ball {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ball-on-fill);
}

.ball--red {
  background: var(--ball-red-fill);
}

.ball--blue {
  background: var(--ball-blue-fill);
}

.bet-row__mult {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* 金额汇总 */
.amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--surface-sunken);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
}

.amount-row__label {
  font-size: 24rpx;
  color: var(--text-muted);
}

.amount-row__value {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.record__actions {
  display: flex;
  gap: 24rpx;
}

.record__actions .record__retake,
.record__actions .record__album,
.record__actions .record__confirm {
  flex: 1;
}

.record__confirm--single {
  width: 100%;
}

/* 相册选图按钮：与"确定"同级并排，字号与主按钮一致 */
.record__album {
  font-size: 32rpx;
  font-weight: 600;
}

.record__album::after {
  border: none;
}

/* 禁用态统一走 .btn-ghost[disabled]（app.wxss），此处不再覆盖色值 */

/* ==================== 校对抽屉（编辑档约 82vh） ==================== */

.editor-mask {
  position: fixed;
  inset: 0;
  background: var(--overlay);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}

.editor-drawer {
  width: 100%;
  height: 82vh;
  min-height: 960rpx;
  max-height: calc(100vh - 120rpx);
  background: var(--surface-raised);
  border-radius: 40rpx 40rpx 0 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.editor-drawer__handle {
  width: 88rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--sheet-handle);
  margin: 20rpx auto 24rpx;
}

.editor-drawer__header {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 0 32rpx 24rpx;
}

.editor-drawer__title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.editor-drawer__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.editor-drawer__tag {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--surface-sunken);
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.editor-drawer__desc {
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--text-muted);
}

/* 当前已选号码预览（红球 - 蓝球 区隔，2026-08-20 新增） */
.editor-drawer__preview {
  margin: 0 32rpx 20rpx;
  padding: 20rpx 24rpx;
  background: var(--surface-sunken);
  border-radius: 16rpx;
}

.editor-drawer__preview-balls {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.editor-drawer__body {
  flex: 1;
  height: 0;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.editor-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: var(--surface-sunken);
  border-radius: 32rpx;
}

.editor-panel--stepper {
  gap: 24rpx;
}

.editor-panel__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.editor-panel__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.editor-panel__summary {
  font-size: 24rpx;
  color: var(--text-muted);
}

.editor-ball-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

/* 未选号码球：surface-card 底 + control 边界 + secondary 字（可识别边界，不用浅灰线） */
.editor-ball {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-card);
  border: 2rpx solid var(--border-control);
  box-sizing: border-box;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

/* 选中：实心填充 + 球内数字用 ball-on-fill；不使用投影（深色层级不靠阴影） */
.editor-ball--selected {
  color: var(--ball-on-fill);
}

.editor-ball--red.editor-ball--selected {
  background: var(--ball-red-fill);
  border-color: var(--ball-red-fill);
}

.editor-ball--blue.editor-ball--selected {
  background: var(--ball-blue-fill);
  border-color: var(--ball-blue-fill);
}

.mult-stepper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.mult-stepper__btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--surface-card);
  border: 2rpx solid var(--border-control);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mult-stepper__btn--primary {
  background: var(--action-bg);
  border-color: var(--action-bg);
}

.mult-stepper__btn--primary .mult-stepper__btn-text {
  color: var(--action-text);
}

.mult-stepper__btn--disabled {
  background: var(--surface-pressed);
  border-color: var(--surface-pressed);
}

.mult-stepper__btn--disabled .mult-stepper__btn-text {
  color: var(--text-disabled);
}

.mult-stepper__btn-text {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--text-primary);
}

.mult-stepper__value {
  flex: 1;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--surface-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mult-stepper__value-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.editor-actions {
  display: flex;
  gap: 24rpx;
  padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  background: var(--surface-raised);
}

.editor-actions .btn-ghost,
.editor-actions .btn-primary {
  flex: 1;
}
