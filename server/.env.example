# ============================================================
# 好运夹 goodluck+ · 服务端环境变量示例
# 复制为 .env 后按需填写：cp .env.example .env
# 所有值都是占位符示例，真实凭据请勿提交到仓库。
# ============================================================

# ===== 应用 =====
NODE_ENV=development
APP_PORT=3000
LOG_LEVEL=info

# ===== 数据库 =====
# 本地 Docker：docker compose up -d mysql —— compose 会读取下面三个 MYSQL_* 建库建用户
# 自建 MySQL：改成 mysql://<用户>:<密码>@<主机>:3306/<库名>，并保持与 MYSQL_* 一致
MYSQL_DATABASE=lottery_helper
MYSQL_USER=lottery
MYSQL_PASSWORD=local_dev_password
MYSQL_ROOT_PASSWORD=local_root_password

DATABASE_URL="mysql://lottery:local_dev_password@127.0.0.1:3306/lottery_helper"

# ===== 微信小程序登录（code2session）=====
# 控制台：微信公众平台 → 开发管理 → 开发设置 → 开发者 ID
# AppID 可公开，AppSecret 绝不可入库；留空时微信登录报错，前端自动降级匿名注册。
# 注意：不要设成 AppID 之外的值，否则 code2session 会返回 40013。
WECHAT_APPID=YOUR_WECHAT_APPID
WECHAT_APPSECRET=YOUR_WECHAT_APPSECRET

# ===== 火山引擎 · 豆包搜索 SearchInfinity（开奖查询）=====
# 开通：https://console.volcengine.com/search-infinity/web-search-exp（每月 500 次免费）
# 留空时开奖同步任务跳过，便于无 Key 本地联调
VOLC_SEARCH_API_KEY=

# ===== 火山引擎 · 火山方舟（OCR 视觉模型 + 号码推演 LLM）=====
# 控制台：https://console.volcengine.com/ark → 右上角头像 → API Key 管理
# 推理接入点：在线推理 → 推理接入点 → 创建 → 复制 ep-xxxxxxxx 填 ARK_LLM_ENDPOINT_ID
# 留空时 OCR 与推演走本地 mock 兜底，便于无 Key 本地联调
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# OCR 视觉模型：需支持 image_url + response_format=json_object
# 2026-10-27 起统一 deepseek-v4-1-flash-261017（实测 1.1~2.3s）；
# 备选 doubao-seed-2.0-lite。直调报错则建推理接入点填 ep-xxx。
ARK_VISION_MODEL=deepseek-v4-1-flash-261017
ARK_LLM_ENDPOINT_ID=
ARK_LLM_MODEL=doubao-seed-2-1-pro-260628

# ===== 业务开关 =====
DRAW_SYNC_ENABLED=true
RECOMMEND_CACHE_DAYS=7
# 兑奖期限（自然日）
REDEEM_DEADLINE_DAYS=60
# 兑奖渠道分界：单注奖金 ≥ 该值走彩票中心（单位：分，1000000 = ¥1 万）
REDEEM_SHOP_THRESHOLD_CENT=1000000
# OCR 上传图片大小上限（字节，2097152 = 2MB）
OCR_IMAGE_MAX_BYTES=2097152

# ===== 腾讯位置服务（「附近」功能后端代理）=====
# 控制台：https://lbs.qq.com/ → 应用管理 → 添加 Key
#   场景=微信小程序、勾选 WebServiceAPI、绑定自己的 AppID
# 必须先在「配额管理 → 账户额度」给该 Key 分配额度，否则接口返回配额错误（不是「Key 无效」）
# 留空时 /api/poi/nearby 返回 status=199（前端走「加载失败 + 重试」），不影响其它接口
TENCENT_LBS_KEY=
TENCENT_LBS_SEARCH_URL=https://apis.map.qq.com/ws/place/v1/search
# 检索参数：keyword 固定「彩票」（实测单词覆盖福彩+体彩，勿改「福利彩票」）；radius 上限 1000m
POI_KEYWORD=彩票
POI_RADIUS=1000
POI_AUTO_EXTEND=1
POI_PAGE_SIZE=20
POI_TIMEOUT_MS=8000
# 服务端单日真实调用上限（个人开发者账号级上限 200 次/日，默认留一半余量）
POI_DAILY_LIMIT=100
# 进程内缓存：TTL 小时 / 最大网格数 / 网格精度（3 位小数 ≈ 100 米格边长）
POI_CACHE_TTL_HOURS=24
POI_CACHE_MAX_ENTRIES=200
POI_GRID_PRECISION=3

# ===== 安全 =====
# 本地种子数据的固定设备令牌（npm run seed 写入）；**生产必须改成随机长串**
SEED_DEVICE_TOKEN=dev-token-local-only
# 眼镜端口令哈希盐：codeHash = sha256(userId + code + salt)
# 留空时使用代码内默认值（仅适合本地开发）；**生产必须填一串随机值，且上线后不可更换**
PAIRING_SALT=
